# Configuration du serveur
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Sécurité & Authentification JWT (OBLIGATOIRE - générer une clé secrète robuste en production)
JWT_SECRET=votre_cle_secrete_jwt_robuste_et_aleatoire_au_moins_32_caracteres
JWT_EXPIRES_IN=30d

# Base de données PostgreSQL
# Option 1 : URI complète (Recommandé pour Render, Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote:5432/nom_base_de_donnees

# Option 2 : Variables séparées (si DATABASE_URL n'est pas utilisé)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yomankash
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_db

# Configuration SSL pour PostgreSQL (Requis en cloud)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_FORCE_SYNC=false

# CORS (Liste séparée par des virgules ou * pour tous)
CORS_ORIGIN=*
# ALLOWED_ORIGINS=https://mon-domaine.com,https://admin.mon-domaine.com

# Rate Limiting
AUTH_RATE_LIMIT_MAX=30

# Services SMS (Orange SMS CI ou Twilio)
SMS_SERVICE_PROVIDER=orange
ORANGE_CLIENT_ID=votre_client_id_orange
ORANGE_CLIENT_SECRET=votre_client_secret_orange
ORANGE_SENDER_PHONE=tel:+22500000000

# Twilio (Alternative SMS)
TWILIO_SID=votre_twilio_sid
TWILIO_AUTH_TOKEN=votre_twilio_auth_token
TWILIO_PHONE=+1234567890

# Service d'envoi d'e-mails (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application
EMAIL_FROM="YomanKash" <contact@yomankash.com>
